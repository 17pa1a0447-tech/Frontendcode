pipeline {
  agent any

  environment {
    DOCKER_IMAGE = "jsandeep9866/frontend-app"
    APP_DIR = "crud-application"
    CONTAINER_NAME = "frontend-container"
    DOCKERHUB_CREDENTIALS = "jsandeep9866" // Jenkins credential id for DockerHub (username/password)
  }

  parameters {
    string(name: 'API_URL', defaultValue: 'http://localhost:9090/api/v1', description: 'Backend API URL to inject')
  }

  stages {

    stage('Checkout') {
      steps {
        deleteDir()
        git branch: 'main', url: 'https://github.com/17pa1a0447-tech/Frontendcode.git'
      }
    }

    stage('Replace API URL') {
      steps {
        sh """
          if [ -f ${APP_DIR}/src/environments/environment.prod.ts ]; then
            sed -i 's#__API_URL__#${params.API_URL}#g' ${APP_DIR}/src/environments/environment.prod.ts
            echo "Replaced API_URL in ${APP_DIR}/src/environments/environment.prod.ts"
          else
            echo "ERROR: ${APP_DIR}/src/environments/environment.prod.ts not found"
            exit 1
          fi
        """
      }
    }

    stage('Build Angular (containerized)') {
      steps {
        dir("${APP_DIR}") {
          sh '''
            set -e
            echo "Checking docker..."
            docker --version || (echo "Docker CLI not found on node"; exit 2)

            # run node:18 container to build; mount workspace so build artifacts appear on host
            echo "Running npm build inside node:18 container (this requires Docker CLI)..."
            cd $PWD
            docker run --rm -v "$PWD":/app -w /app node:18 sh -c "npm ci --no-audit --no-fund && npm run build -- --configuration=production"
            
            echo "Build finished, listing dist folder:"
            ls -la dist || true
          '''
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        dir("${APP_DIR}") {
          sh """
            set -e
            docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest .
          """
        }
      }
    }

    stage('Docker Login & Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: env.DOCKERHUB_CREDENTIALS, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            set -e
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
            docker push ${DOCKER_IMAGE}:latest
            docker logout
          '''
        }
      }
    }

    stage('Deploy') {
      steps {
        sh """
          set -e
          docker rm -f ${CONTAINER_NAME} || true
          docker run -d --name ${CONTAINER_NAME} -p 3025:80 ${DOCKER_IMAGE}:latest
          docker ps --filter "name=${CONTAINER_NAME}" --format "table {{.ID}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}"
        """
      }
    }

  } // stages

  post {
    success { echo "Frontend pipeline finished successfully." }
    failure { echo "Frontend pipeline failed — check console log." }
  }
}
